{
    "$schema": "https://biomejs.dev/schemas/2.5.2/schema.json",

    "vcs": {
        "enabled": true,
        "clientKind": "git",
        "useIgnoreFile": true
    },
    "formatter": {
        "enabled": true,
        "indentStyle": "space",
        "indentWidth": 4
    },
    "javascript": {
        "formatter": {
            "quoteStyle": "single"
        }
    },
    "linter": {
        "enabled": true,
        "rules": {
            "preset": "recommended",
            "performance": {
                "noAccumulatingSpread": "warn"
            },
            "style": {
                "noNonNullAssertion": "warn"
            },
            "suspicious": {
                "noAssignInExpressions": "off"
            },
            "correctness": {
                "noUnusedImports": "error"
            }
        }
    },
    "assist": {
        "actions": {
            "source": {
                "organizeImports": "on"
            }
        }
    }
}
