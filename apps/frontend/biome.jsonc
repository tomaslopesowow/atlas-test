{
    "$schema": "https://biomejs.dev/schemas/2.5.2/schema.json",
    "root": false,
    "extends": "//",

    "files": {
        "includes": [
            "**",
            // shadcn/ui's components, as its cli writes them, so `shadcn add --overwrite` can replace them
            "!src/components/ui",
            "!src/lib"
        ]
    },
    "css": {
        "parser": {
            "tailwindDirectives": true
        }
    }
}
