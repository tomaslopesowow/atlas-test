# --- api ---

API_PORT="3001"

# The admin account, holding every permission. Created at boot with ADMIN_PASSWORD
# when it does not exist, so no one can register the email first; the password is
# only read then. An account that already has the email is made admin. Unset: no admin.
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change me, at least 8 characters"

# How long a sign-in lasts, in days.
SESSION_TTL_DAYS="30"

# --- database: docker/compose.yml ---

DB_HOST="localhost"
DB_PORT="5432"
DB_USERNAME="atlas"
DB_PASSWORD="atlas"
DB_DATABASE="atlas"

# --- media ---

STORAGE_DISK="local"
STORAGE_LOCAL_PATH="./uploads"
STORAGE_MAX_FILE_SIZE="5242880"
STORAGE_ALLOWED_MIME_TYPES="image/jpeg,image/png,image/webp"

# --- notifications: mail goes to the Mailpit in docker/compose.yml ---

NOTIFICATIONS_DEFAULT_LOCALE="en"
NOTIFICATIONS_MAIL_PROVIDER="smtp"
MAIL_FROM="Atlas <hello@example.com>"
SMTP_HOST="localhost"
SMTP_PORT="1025"
NOTIFICATIONS_PUSH_PROVIDERS="expo"
