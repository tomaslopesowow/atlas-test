{
    "name": "api",
    "version": "0.0.1",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "rm -rf dist && tsc -p tsconfig.build.json",
        "start": "node --enable-source-maps --env-file=.env dist/main.js",
        "dev": "tsc -p tsconfig.build.json && (tsc -p tsconfig.build.json -w --preserveWatchOutput & node --watch --enable-source-maps --env-file=.env dist/main.js)",
        "typecheck": "tsc --noEmit -p tsconfig.test.json",
        "test": "rm -rf .test-dist && tsc -p tsconfig.test.json && node --enable-source-maps --test \".test-dist/src/**/*.spec.js\"",
        "test:e2e": "rm -rf .test-dist && tsc -p tsconfig.test.json && node --enable-source-maps --test --test-concurrency=1 \".test-dist/test/**/*.e2e-spec.js\"",
        "docker:up": "docker compose -f docker/compose.yml up -d",
        "docker:down": "docker compose -f docker/compose.yml down"
    },
    "dependencies": {
        "@nestjs/common": "^12.0.3",
        "@nestjs/config": "^12.0.0",
        "@nestjs/core": "^12.0.3",
        "@nestjs/platform-express": "^12.0.3",
        "@nestjs/typeorm": "^12.0.1",
        "@repo/media": "workspace:*",
        "@repo/notifications": "workspace:*",
        "@repo/rbac": "workspace:*",
        "class-transformer": "^0.5.1",
        "class-validator": "^0.15.1",
        "pg": "^8.23.0",
        "reflect-metadata": "^0.2.2",
        "rxjs": "^7.8.2",
        "typeorm": "^1.1.1"
    },
    "devDependencies": {
        "@types/express": "^5.0.6",
        "@types/multer": "^2.2.0",
        "@types/node": "^26.1.0",
        "typescript": "^6.0.3"
    }
}
