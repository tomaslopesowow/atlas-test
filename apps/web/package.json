{
    "name": "web",
    "version": "1.0.0",
    "private": true,
    "type": "module",
    "scripts": {
        "clean": "rm -rf .next .turbo node_modules playwright-report test-results",
        "docker:up": "docker compose -f ../../docker/compose.yml up -d",
        "dev": "next dev --turbopack",
        "build": "node generate-blocks-import-map.js && NODE_OPTIONS=--max-old-space-size=4096 next build",
        "start": "next start",
        "lint": "biome check",
        "lint:fix": "biome check --write",
        "typecheck": "rm -r ./.next || node generate-blocks-import-map.js && tsc --noEmit",
        "test:e2e": "playwright test",
        "test:codegen": "playwright codegen",
        "codegen": "concurrently 'node generate-blocks-import-map.js' 'gql-tada generate-output' 'pnpm run generate:importmap' 'pnpm run generate:types'",
        "generate:importmap": "payload generate:importmap",
        "generate:types": "payload generate:types",
        "postinstall": "next telemetry disable",
        "extract:news": "node ./seed/craftcms/extract-news-articles.js",
        "extract:yachts": "node ./seed/craftcms/extract-yacht-data.js",
        "extract:all": "pnpm extract:news && pnpm extract:yachts",
        "deduplicate:articles": "node ./seed/craftcms/deduplicate-articles.js",
        "deduplicate:yachts": "node ./seed/craftcms/deduplicate-yachts.js",
        "deduplicate:all": "pnpm deduplicate:articles && pnpm deduplicate:yachts"
    },
