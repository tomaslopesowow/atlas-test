# Common
ALLOW_ROBOTS="no"
ANALYZE="no"
RELUME="yes"
USE_COOKIE_NOTICE="yes"

# Sentry
SENTRY_ORG="owow"
SENTRY_PROJECT=
SENTRY_DSN=

# E-commerce - "yes" or "no"
NEXT_PUBLIC_ECOMMERCE=

# Shopify - public
NEXT_PUBLIC_SHOPIFY_STORE_DOMAIN=
NEXT_PUBLIC_SHOPIFY_STOREFRONT_API_VERSION=
NEXT_PUBLIC_SHOPIFY_STOREFRONT_API_PUBLIC_ACCESS_TOKEN=

# Shopify - admin
SHOPIFY_ADMIN_API_VERSION=
SHOPIFY_ADMIN_API_ACCESS_TOKEN=

# Payload CMS - private
PAYLOAD_SECRET=
DATABASE_URI="mongodb://127.0.0.1:27017/atlas"
PAYLOAD_CMS_ENDPOINT="http://localhost:3001/api/graphql"
PAYLOAD_AUTH_OTP="yes"
PAYLOAD_FIRST_USER=

# Payload CMS - mail - private
MAIL_DRIVER=
MAIL_HOST=
MAIL_PORT=
MAIL_USERNAME=
MAIL_PASSWORD=
SES_REGION=
SES_ACCESS_KEY=
SES_SECRET_ACCESS_KEY=

# S3 - private
S3_BUCKET=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=
S3_CDN_URL=

# Nasty spyware
NEXT_TELEMETRY_DISABLED=1
