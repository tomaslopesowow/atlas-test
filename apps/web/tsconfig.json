{
    "compilerOptions": {
        "incremental": true,
        "target": "esnext",
        "jsx": "react-jsx",
        "lib": ["dom", "dom.iterable", "esnext"],
        "module": "esnext",
        "moduleResolution": "bundler",
        "paths": {
            "@/*": ["./*"],
            "@payload-config": ["./payload.config.ts"]
        },
        "resolveJsonModule": true,
        "allowJs": true,
        "strict": true,
        "noEmit": true,
        "esModuleInterop": true,
        "isolatedModules": true,
        "verbatimModuleSyntax": true,
        "skipLibCheck": true,
        "plugins": [
            {
                "name": "next"
            },
            {
                "name": "gql.tada/ts-plugin",
                "schemas": [
                    {
                        "name": "shopify-storefront",
                        "schema": "node_modules/@shopify/hydrogen-react/storefront.schema.json",
                        "tadaOutputLocation": "./features/shopify/api/env.storefront.d.ts"
                    },
                    {
                        "name": "shopify-admin",
                        "schema": "https://shopify.dev/admin-graphql-direct-proxy/2025-01",
                        "tadaOutputLocation": "./features/shopify/api/env.admin.d.ts"
                    }
                ]
            }
        ]
    },
    "include": [
        "global.d.ts",
        "next-env.d.ts",
        "payload-env.d.ts",
        "**/*.ts",
        "**/*.tsx",
        ".next/types/**/*.ts",
        ".next/dev/types/**/*.ts"
    ],
    "exclude": ["node_modules"]
}
