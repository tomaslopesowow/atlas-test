{
    "compilerOptions": {
        "incremental": true,
        "target": "esnext",
        "jsx": "react-jsx",
        "lib": ["dom", "dom.iterable", "esnext"],
        "module": "esnext",
        "moduleResolution": "bundler",
        "paths": {
            "@/*": ["./*"],
            "@payload-config": ["./payload.config.ts"]
        },
        "resolveJsonModule": true,
        "allowJs": true,
        "strict": true,
        "noEmit": true,
        "esModuleInterop": true,
        "isolatedModules": true,
        "verbatimModuleSyntax": true,
        "skipLibCheck": true,
        "plugins": [
            {
                "name": "next"
            }
        ]
    },
    "include": [
        "global.d.ts",
        "next-env.d.ts",
        "payload-env.d.ts",
        "**/*.ts",
        "**/*.tsx",
        ".next/types/**/*.ts",
        ".next/dev/types/**/*.ts"
    ],
    "exclude": ["node_modules"]
}
