# Common
ALLOW_ROBOTS="no"
ANALYZE="no"
RELUME="no"
USE_COOKIE_NOTICE="no"
OPENAI_API_KEY=

# Sentry
SENTRY_ORG="owow"
SENTRY_PROJECT=
SENTRY_DSN=

# E-commerce - "yes" or "no"
NEXT_PUBLIC_ECOMMERCE="no"

# Shopify - public
NEXT_PUBLIC_SHOPIFY_STORE_DOMAIN=
NEXT_PUBLIC_SHOPIFY_STOREFRONT_API_VERSION=
NEXT_PUBLIC_SHOPIFY_STOREFRONT_API_PUBLIC_ACCESS_TOKEN=

# Shopify - admin
SHOPIFY_ADMIN_API_VERSION=
# SHOPIFY_ADMIN_API_ACCESS_TOKEN=CONFIGURE_ME_IN_GITHUB

# Payload CMS - private
# PAYLOAD_SECRET=CONFIGURE_ME_IN_GITHUB
# DATABASE_URI=CONFIGURE_ME_IN_GITHUB_AS "mongodb://username:password@mongo:27017/atlas?authSource=admin"
PAYLOAD_CMS_ENDPOINT="http://localhost:3001/api/graphql"
PAYLOAD_AUTH_OTP="yes"
PAYLOAD_FIRST_USER="admin@owow.io"

# Payload CMS - mail - private
MAIL_DRIVER=smtp
MAIL_HOST=mailpit
MAIL_PORT=8025
# MAIL_USERNAME=CONFIGURE_ME_IN_GITHUB
# MAIL_PASSWORD=CONFIGURE_ME_IN_GITHUB
SES_REGION=
# SES_ACCESS_KEY=CONFIGURE_ME_IN_GITHUB
# SES_SECRET_ACCESS_KEY=CONFIGURE_ME_IN_GITHUB

# S3 - private
S3_BUCKET=
S3_ENDPOINT=
# S3_ACCESS_KEY_ID=CONFIGURE_ME_IN_GITHUB
# S3_SECRET_ACCESS_KEY=CONFIGURE_ME_IN_GITHUB
S3_REGION=
S3_CDN_URL=

# Nasty spyware
NEXT_TELEMETRY_DISABLED=1
