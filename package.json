{
    "dependencies": {
        "@graphql-typed-document-node/core": "^3.2.0",
        "@urql/core": "^5.0.3",
        "graphql-tag": "^2.12.6",
        "react-markdown": "^9.0.3",
        "urql": "^4.0.7"
    },
    "devDependencies": {
        "@biomejs/biome": "2.3.10",
        "@commitlint/cli": "^18.4.4",
        "@commitlint/config-conventional": "^18.4.4",
        "@graphql-codegen/client-preset": "^4.2.5",
        "@graphql-codegen/typescript-urql": "^4.0.0",
        "@playwright/test": "^1.41.0",
        "@radix-ui/react-icons": "^1.3.2",
        "@repo/payload-video-transcoding-plugin": "workspace:*",
        "@repo/typescript-config": "workspace:*",
        "@turbo/gen": "^2.5.5",
        "@types/handlebars-helpers": "^0.5.6",
        "@types/react-test-renderer": "^18.0.7",
        "dotenv": "^16.3.1",
        "dotenv-cli": "^7.3.0",
        "handlebars-helpers": "^0.10.0",
        "husky": "^8.0.3",
        "jsdom": "^23.2.0",
        "raw-loader": "^4.0.2",
        "react-test-renderer": "^19.0.0",
        "tsup": "^8.3.5",
        "turbo": "^2.5.0",
        "typescript": "^5.9.3",
        "vercel": "^33.4.1"
    },
    "engines": {
        "node": ">=24"
    },
    "name": "atlas",
    "packageManager": "pnpm@10.18.3",
    "private": true,
    "scripts": {
        "bootstrap": "turbo gen bootstrap",
        "build:packages": "pnpm run build --filter @repo/*",
        "build": "turbo build",
        "clean:hard": "pnpm run clean && pnpm store prune",
        "clean": "turbo clean && rm -rf node_modules pnpm-lock.yaml .turbo",
        "codegen": "turbo codegen",
        "dev": "turbo dev",
        "docker:up": "docker compose -f docker/compose.yml up -d",
        "generate": "turbo gen",
        "lint:fix": "turbo lint:fix lint:root:fix",
        "lint:root:fix": "biome check --write --config-path='./biome.workspace.jsonc' ./",
        "lint:root": "biome check --config-path='./biome.workspace.jsonc' ./",
        "lint": "turbo lint lint:root",
        "postinstall": "if [ -z $CI ]; then husky install; fi",
        "start": "turbo start",
        "test:codegen": "turbo test:codegen",
        "test:e2e": "turbo test:e2e",
        "typecheck": "turbo typecheck",
        "update:nextjs": "pnpm up -r next@latest next-intl@latest --save-exact",
        "update:payload": "pnpm up -r payload@latest '@payloadcms/*@latest' --save-exact",
        "update:react": "pnpm up -r react@latest react-dom@latest @types/react@latest @types/react-dom@latest --save-exact"
    }
}
