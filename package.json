{
    "name": "atlas",
    "version": "0.0.1",
    "private": true,
    "packageManager": "pnpm@11.5.1+sha512.93f7b57422ea7068257235b4c16eb60762eb68e1dc23723199cc739043ea9be2c4143274a399d8c6defa2b1176226d9ca1c4b63482d6200c1a8fbaa78c1d1485",
    "engines": {
        "node": ">=24"
    },
    "scripts": {
        "bootstrap": "turbo gen bootstrap",
        "build": "turbo build",
        "build:packages": "pnpm run build --filter @repo/*",
        "clean": "turbo clean && rm -rf node_modules pnpm-lock.yaml .turbo",
        "clean:hard": "pnpm run clean && pnpm store prune",
        "codegen": "turbo codegen",
        "generate": "turbo gen",
        "docker:up": "docker compose -f docker/compose.yml up -d",
        "dev": "turbo dev",
        "lint": "biome check",
        "lint:fix": "biome check --write",
        "start": "turbo start",
        "test:codegen": "turbo test:codegen",
        "typecheck": "turbo typecheck",
        "version:bump": "./scripts/bump-version.sh",
        "update:nextjs": "pnpm up -r next@latest next-intl@latest --save-exact",
        "update:payload": "pnpm up -r payload@latest '@payloadcms/*@latest' --save-exact",
        "update:react": "pnpm up -r react@latest react-dom@latest @types/react@latest @types/react-dom@latest --save-exact",
        "update:all": "pnpm up -r --latest --save-exact",
        "postinstall": "if [ -z $CI ]; then husky install; fi"
    },
    "devDependencies": {
        "@biomejs/biome": "2.4.15",
        "@commitlint/cli": "^21.0.1",
        "@commitlint/config-conventional": "^21.0.1",
        "@graphql-codegen/client-preset": "^6.0.0",
        "@graphql-codegen/typescript-urql": "^5.0.1",
        "@playwright/test": "^1.60.0",
        "@radix-ui/react-icons": "^1.3.2",
        "@turbo/gen": "^2.9.14",
        "@types/handlebars-helpers": "^0.5.6",
        "@types/react-test-renderer": "^19.1.0",
        "dotenv": "^17.4.2",
        "dotenv-cli": "^11.0.0",
        "handlebars-helpers": "^0.10.0",
        "husky": "^9.1.7",
        "jsdom": "^29.1.1",
        "raw-loader": "^4.0.2",
        "react-test-renderer": "^19.2.6",
        "tsup": "^8.5.1",
        "turbo": "^2.9.14",
        "vercel": "^54.4.1"
    },
    "dependencies": {
        "@graphql-typed-document-node/core": "^3.2.0",
        "@urql/core": "^6.0.1",
        "graphql-tag": "^2.12.6",
        "typescript": "^6.0.3",
        "urql": "^5.0.2"
    }
}
