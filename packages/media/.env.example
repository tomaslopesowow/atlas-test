# --- media ---

# Where files are stored: "local" or "s3". Local works for one instance only, as
# other instances can neither serve its files nor convert them.
STORAGE_DISK="local"

# Where "local" keeps files, resolved against the working directory at boot.
STORAGE_LOCAL_PATH="./uploads"

# The largest upload, in bytes (5 MB).
STORAGE_MAX_FILE_SIZE="5242880"

# The largest image, in pixels (width × height): a small compressed file can hide a huge image.
STORAGE_MAX_IMAGE_PIXELS="50000000"

# The upload types accepted, comma-separated.
STORAGE_ALLOWED_MIME_TYPES="image/jpeg,image/png,image/webp"

# Required when STORAGE_DISK is "s3".
# The bucket uploads go to.
# S3_BUCKET=""
# The S3 api's url, e.g. "https://s3.eu-west-1.amazonaws.com".
# S3_ENDPOINT=""
# The key media signs in with; it needs read and write access to the bucket.
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""
# The bucket's region, e.g. "eu-west-1".
# S3_REGION=""

# Optional: serve through a CDN rather than the bucket endpoint.
# S3_CDN_URL=""

# Optional: the canned ACL every upload gets. Unset sends none, leaving access
# to the bucket policy: AWS buckets reject ACLs by default. DigitalOcean Spaces
# makes a file public through its ACL, so set "public-read" there.
# S3_ACL="public-read"
