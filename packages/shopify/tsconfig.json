{
    "include": ["src/**/*"],
    "compilerOptions": {
        "rootDir": "src",
        "outDir": "dist",
        "ignoreDeprecations": "6.0", // < tsup injects the baseUrl, so we have to ignore this for now
        "incremental": false,
        "target": "esnext",
        "jsx": "react-jsx",
        "lib": ["dom", "dom.iterable", "esnext"],
        "module": "esnext",
        "moduleResolution": "bundler",
        "paths": {
            "@/*": ["./src/*"]
        },
        "resolveJsonModule": true,
        "strict": true,
        "esModuleInterop": true,
        "isolatedModules": true,
        "verbatimModuleSyntax": true,
        "skipLibCheck": true,
        "noUncheckedIndexedAccess": true,
        "declaration": true,
        "declarationMap": false,
        "plugins": [
            {
                "name": "gql.tada/ts-plugin",
                "schemas": [
                    {
                        "name": "shopify-storefront",
                        "schema": "node_modules/@shopify/hydrogen-react/storefront.schema.json",
                        "tadaOutputLocation": "./src/api/env.storefront.d.ts"
                    },
                    {
                        "name": "shopify-admin",
                        "schema": "https://shopify.dev/admin-graphql-direct-proxy/2025-01",
                        "tadaOutputLocation": "./src/api/env.admin.d.ts"
                    }
                ]
            }
        ]
    },
    "exclude": ["node_modules", "dist"]
}
