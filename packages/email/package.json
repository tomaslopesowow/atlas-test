{
    "name": "@repo/email",
    "version": "0.0.1",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "tsup",
        "dev": "concurrently --kill-others --names d,m 'tsup --watch' 'email dev --dir src/emails --port 3025'",
        "typecheck": "tsc --noEmit",
        "clean": "rm -rf node_modules .turbo dist"
    },
    "tsup": {
        "entry": [
            "src/**/*.ts",
            "src/**/*.tsx"
        ],
        "splitting": true,
        "sourcemap": true,
        "clean": true,
        "dts": true,
        "format": [
            "cjs",
            "esm"
        ]
    },
    "exports": {
        "./*": {
            "types": "./dist/*.d.ts",
            "import": "./dist/*.js",
            "require": "./dist/*.cjs"
        }
    },
    "dependencies": {
        "@repo/i18n": "workspace:*",
        "react": "19.2.7",
        "react-email": "^6.6.6",
        "use-intl": "^4.13.1"
    },
    "devDependencies": {
        "@react-email/ui": "^6.6.6",
        "@types/react": "19.2.17",
        "@types/react-dom": "19.2.3",
        "concurrently": "^10.0.3",
        "tsup": "^8.5.1",
        "typescript": "^6.0.3"
    }
}
