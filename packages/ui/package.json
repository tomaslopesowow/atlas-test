{
    "name": "@repo/ui",
    "version": "0.0.1",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "tsup",
        "dev": "tsup --watch",
        "typecheck": "tsc --noEmit",
        "clean": "rm -rf node_modules .turbo dist"
    },
    "tsup": {
        "entry": [
            "src/**/*.ts",
            "src/**/*.tsx"
        ],
        "splitting": true,
        "sourcemap": true,
        "clean": true,
        "dts": true,
        "format": [
            "cjs",
            "esm"
        ]
    },
    "exports": {
        "./*": {
            "types": "./dist/*.d.ts",
            "import": "./dist/*.js",
            "require": "./dist/*.cjs"
        }
    },
    "dependencies": {
        "@radix-ui/react-checkbox": "^1.3.7",
        "@radix-ui/react-dialog": "^1.1.19",
        "@radix-ui/react-label": "^2.1.11",
        "@radix-ui/react-navigation-menu": "^1.2.18",
        "@radix-ui/react-popover": "^1.1.19",
        "@radix-ui/react-select": "^2.3.3",
        "@radix-ui/react-slot": "^1.3.0",
        "@radix-ui/react-switch": "^1.3.3",
        "@repo/lib": "workspace:*",
        "embla-carousel-react": "^8.6.0",
        "lucide-react": "^1.23.0",
        "react-use": "^17.6.1",
        "tailwind-variants": "^0.2.1",
        "vaul": "^1.1.2"
    },
    "peerDependencies": {
        "next": "16.2.10",
        "next-intl": "^4.13.1",
        "react": "19.2.7",
        "react-dom": "19.2.7"
    },
    "devDependencies": {
        "@types/node": "^26.1.0",
        "@types/react": "19.2.17",
        "@types/react-dom": "19.2.3",
        "next": "16.2.10",
        "next-intl": "^4.13.1",
        "react": "19.2.7",
        "react-dom": "19.2.7",
        "tsup": "^8.5.1",
        "typescript": "^6.0.3"
    }
}
