{
    "name": "@repo/lib",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "tsup": {
        "entry": ["src/*.ts"],
        "splitting": true,
        "sourcemap": true,
        "clean": true,
        "dts": true,
        "format": ["cjs", "esm"]
    },
    "scripts": {
        "build": "tsup",
        "clean": "rm -rf node_modules .turbo dist",
        "dev": "tsup --watch",
        "lint": "biome check",
        "lint:fix": "biome check --write",
        "typecheck": "tsc --noEmit"
    },
    "exports": {
        "./*": {
            "types": "./dist/*.d.ts",
            "import": "./dist/*.js",
            "require": "./dist/*.cjs"
        }
    },
    "devDependencies": {
        "@repo/typescript-config": "workspace:*",
        "@types/node": "^20.10.6"
    }
}
