# --- notifications ---

# The locale a notification is sent in when its recipient has none.
NOTIFICATIONS_DEFAULT_LOCALE="en"

# The mail provider in use: "smtp", or the name of your own @MailProvider();
# unset switches mail off.
NOTIFICATIONS_MAIL_PROVIDER="smtp"

# The sender of every mail; required when mail is on.
MAIL_FROM="hello@example.com"

# Required when the mail provider is "smtp"; these reach a local Mailpit.
# Port 465 uses TLS from the start; any other port upgrades with STARTTLS.
SMTP_HOST="localhost"
SMTP_PORT="1025"
# The account to sign in with, when the server needs one; setting it requires TLS.
# SMTP_USER=""
# SMTP_PASSWORD=""

# The push providers devices may register with, comma-separated, the first being
# the default; unset switches push off.
NOTIFICATIONS_PUSH_PROVIDERS="expo"

# Optional: only needed when push security is enabled for the Expo project.
# EXPO_ACCESS_TOKEN=""
