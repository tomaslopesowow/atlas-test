# --- notifications ---

NOTIFICATIONS_DEFAULT_LOCALE="en"

# The mail provider in use; unset switches mail off.
NOTIFICATIONS_MAIL_PROVIDER="smtp"
MAIL_FROM="hello@example.com"

# Required when the mail provider is "smtp"; these reach the Mailpit in docker/compose.yml.
SMTP_HOST="localhost"
SMTP_PORT="1025"
# SMTP_USER=""
# SMTP_PASSWORD=""

# The push providers devices may register with, comma-separated, the first being
# the default; unset switches push off.
NOTIFICATIONS_PUSH_PROVIDERS="expo"

# Optional: only needed when push security is enabled for the Expo project.
# EXPO_ACCESS_TOKEN=""
